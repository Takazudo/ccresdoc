{
  "name": "ccresdoc",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm -C app run dev",
    "build": "pnpm -C app run build",
    "app:dev": "cargo tauri dev",
    "app:build": "cargo tauri build",
    "rebuild:local-app": "bash scripts/rebuild-local-app.sh",
    "b4push": "./scripts/run-b4push.sh",
    "check:dependencies": "bash scripts/check-zfb-pin.sh && pnpm -C app run validate:dependencies",
    "check:types": "pnpm -C app run typecheck",
    "check:zfb": "pnpm -C app run check:zfb",
    "test:frontend": "pnpm -C app run test:run",
    "test:macos-settings": "bash scripts/test-macos-settings.sh",
    "test:runtime-digest": "node --test scripts/runtime-workspace-digest.test.mjs",
    "test:release-contract": "node --test scripts/release-contract.test.mjs",
    "test:release-publication": "node --test scripts/release-publication.test.mjs",
    "check:release-contract": "node scripts/release-contract.mjs check --json",
    "check:frontend": "pnpm -C app run check",
    "check:compatibility": "bash scripts/check-node-free-compatibility.sh",
    "stage:runtime": "node scripts/stage-runtime-workspace.mjs",
    "check:runtime-package": "pnpm run test:runtime-digest && node scripts/stage-runtime-workspace.mjs && node scripts/verify-runtime-workspace.mjs",
    "probe:runtime-package": "pnpm run check:runtime-package && node scripts/probe-tauri-runtime.mjs"
  }
}
