{
  "identifier": "default",
  "description": "Minimal docs/loading window capabilities",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:*/*", "http://127.0.0.1:*/*"]
  },
  "permissions": [
    "core:default",
    "allow-retry-launch",
    "allow-open-settings-window",
    "allow-update-appearance"
  ]
}
