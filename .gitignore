# Worktrees (managed by /x-wt-teams; never tracked)
worktrees/
__inbox/

# Rust
target/
src-tauri/target/

# Node
node_modules/
app/.zfb/
app/.zfb-build/
app/dist/**
app/public/theme-packs/
app/public/docs/search-index.json
release-artifacts/

# Runtime-generated resource detail MDX (not committed; rebuilt on launch).
# The coordinator-owned overview shells remain permanent source files.
app/src/content/docs/claude*/
app/src/content/docs/codex*/
!app/src/content/docs/claude/
app/src/content/docs/claude/*
!app/src/content/docs/claude/index.mdx
!app/src/content/docs/codex/
app/src/content/docs/codex/*
!app/src/content/docs/codex/index.mdx
# Explicit detail/status and transition namespaces remain ignored even if the
# parent patterns are changed later. Generic claude/ and codex/ landings above
# are permanent checked-in coordinator inputs.
app/src/content/docs/claude-*/
app/src/content/docs/codex-*/
app/src/content/docs/.ccresdoc-*/
app/src/content/docs/.ccresdoc-resource-transitions/
app/.ccresdoc-*/

# Logs
*.log

# OS
.DS_Store
