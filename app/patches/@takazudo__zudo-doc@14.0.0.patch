 import { SEARCH_WIDGET_SCRIPT } from "./generated-script.js";
+const SEARCH_COMMAND_EVENT = "zudo-doc:search-command";
+function dispatchSearchCommand(action, refresh = false) {
+  document.dispatchEvent(new CustomEvent(SEARCH_COMMAND_EVENT, { detail: { action, refresh } }));
+}
+function openSearch(options = {}) {
+  dispatchSearchCommand("open", options.refresh !== false);
+}
+function closeSearch() {
+  dispatchSearchCommand("close");
+}
+function refreshSearch() {
+  dispatchSearchCommand("refresh", true);
+}
