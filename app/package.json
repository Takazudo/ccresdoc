{
  "name": "@ccresdoc/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "description": "CCResDoc zudo-doc consumer — built by zfb, served node-free by `zfb dev` (port 4892) under the Tauri sidecar host",
  "scripts": {
    "postinstall": "node scripts/sync-theme-packs.mjs",
    "predev": "pnpm run sync:theme-packs",
    "dev": "zfb dev",
    "prebuild": "pnpm run sync:theme-packs",
    "build": "zfb build",
    "preview": "zfb preview",
    "zfb": "zfb",
    "sync:theme-packs": "node scripts/sync-theme-packs.mjs",
    "validate:theme-packs": "node scripts/sync-theme-packs.mjs --check",
    "validate:dependencies": "node ../scripts/validate-dependencies.mjs --installed",
    "typecheck": "tsc --noEmit",
    "precheck:zfb": "pnpm run sync:theme-packs",
    "check:zfb": "zfb check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:theme-packs": "node --test scripts/sync-theme-packs.test.mjs",
    "precheck": "pnpm run sync:theme-packs",
    "check": "pnpm run validate:dependencies && pnpm run validate:theme-packs && pnpm run typecheck && pnpm run check:zfb && pnpm run test:run && pnpm run test:theme-packs"
  },
  "dependencies": {
    "@takazudo/zfb": "2.10.1",
    "@takazudo/zfb-md-wasm": "2.10.1",
    "@takazudo/zfb-runtime": "2.10.1",
    "@takazudo/zudo-doc": "5.12.0",
    "katex": "0.16.22",
    "preact": "10.29.1",
    "preact-render-to-string": "6.6.7",
    "zod": "4.3.6"
  },
  "optionalDependencies": {
    "@takazudo/zfb-darwin-arm64": "2.10.1",
    "@takazudo/zfb-darwin-x64": "2.10.1",
    "@takazudo/zfb-linux-arm64-gnu": "2.10.1",
    "@takazudo/zfb-linux-x64-gnu": "2.10.1",
    "@takazudo/zfb-win32-x64-msvc": "2.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.0",
    "happy-dom": "20.7.0",
    "tailwindcss": "4.2.0",
    "typescript": "5.9.2",
    "vitest": "4.0.17"
  }
}
