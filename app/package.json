{
  "name": "@ccresdoc/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "description": "CCResDoc zudo-doc consumer \u2014 built by zfb, served node-free by `zfb dev` (port 4892) under the Tauri sidecar host",
  "scripts": {
    "postinstall": "node scripts/sync-theme-packs.mjs",
    "predev": "pnpm run sync:theme-packs",
    "dev": "zfb dev",
    "prebuild": "pnpm run sync:theme-packs",
    "build": "zfb build",
    "preview": "zfb preview",
    "zfb": "zfb",
    "sync:theme-packs": "node scripts/sync-theme-packs.mjs",
    "validate:theme-packs": "node scripts/sync-theme-packs.mjs --check",
    "validate:dependencies": "node ../scripts/validate-dependencies.mjs --installed --scope app",
    "typecheck": "tsc --noEmit",
    "precheck:zfb": "pnpm run sync:theme-packs",
    "check:zfb": "zfb check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:settings": "node --test ../src-tauri/frontend/settings-backend.test.mjs ../src-tauri/frontend/settings-shell.test.mjs",
    "test:theme-packs": "node --test scripts/sync-theme-packs.test.mjs",
    "precheck": "pnpm run sync:theme-packs",
    "check": "pnpm run validate:dependencies && pnpm run validate:theme-packs && pnpm run typecheck && pnpm run check:zfb && pnpm run test:run && pnpm run test:settings && pnpm run test:theme-packs"
  },
  "dependencies": {
    "@takazudo/zfb": "6.0.1",
    "@takazudo/zfb-md-wasm": "6.0.1",
    "@takazudo/zfb-runtime": "6.0.1",
    "@takazudo/zudo-doc": "10.0.2",
    "katex": "0.19.1",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "@takazudo/zfb-darwin-arm64": "6.0.1",
    "@takazudo/zfb-darwin-x64": "6.0.1",
    "@takazudo/zfb-linux-arm64-gnu": "6.0.1",
    "@takazudo/zfb-linux-x64-gnu": "6.0.1",
    "@takazudo/zfb-win32-x64-msvc": "6.0.1"
  },
  "devDependencies": {
    "happy-dom": "21.0.4",
    "playwright": "1.62.1",
    "typescript": "5.9.2",
    "vite": "8.3.7",
    "vitest": "4.1.12"
  }
}
