{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@takazudo/zudo-doc/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "pages/**/*",
    "src/**/*",
    "test/**/*",
    "vitest.config.ts",
    "zfb.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
