{
  "wholesale": {
    "framework": "preact",
    "port": 4892,
    "base": "/",
    "trailingSlash": true,
    "minifyHtml": true,
    "collections": [
      {
        "name": "docs",
        "path": "src/content/docs",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "sidebar_position": {
              "type": "number"
            },
            "sidebar_label": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "search_exclude": {
              "type": "boolean"
            },
            "pagination_next": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "pagination_prev": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "draft": {
              "type": "boolean"
            },
            "unlisted": {
              "type": "boolean"
            },
            "hide_sidebar": {
              "type": "boolean"
            },
            "hide_toc": {
              "type": "boolean"
            },
            "wide": {
              "type": "boolean"
            },
            "doc_history": {
              "type": "boolean"
            },
            "standalone": {
              "type": "boolean"
            },
            "slug": {
              "type": "string"
            },
            "generated": {
              "type": "boolean"
            },
            "category_no_page": {
              "type": "boolean"
            },
            "category_sort_order": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            },
            "category_shape": {
              "type": "string",
              "enum": [
                "note-tray"
              ]
            },
            "note_tray_dated": {
              "type": "boolean"
            },
            "note_tray_sidebar": {
              "type": "string",
              "enum": [
                "index",
                "year",
                "month"
              ]
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "updated": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": {}
        }
      }
    ],
    "plugins": [
      {
        "name": "@takazudo/zudo-doc/plugins/routes",
        "options": {
          "settings": {
            "colorScheme": "Default Dark",
            "colorMode": {
              "defaultMode": "dark",
              "lightScheme": "Default Light",
              "darkScheme": "Default Dark",
              "respectPrefersColorScheme": true
            },
            "siteName": "CCResDoc compatibility probe",
            "siteDescription": "zfb 2.10.1 + zudo-doc 5.12.0 node-free architecture probe",
            "logo": "auto",
            "base": "/",
            "trailingSlash": true,
            "home": {
              "wide": false
            },
            "siteTreeNavIgnore": [],
            "minifyHtml": true,
            "docsDir": "src/content/docs",
            "entryDocSlug": "getting-started",
            "defaultLocale": "en",
            "locales": {},
            "mermaid": true,
            "noindex": false,
            "editUrl": false,
            "githubUrl": false,
            "siteUrl": "",
